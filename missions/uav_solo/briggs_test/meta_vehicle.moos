//-------------------------------------------------
// FILE: meta_vehicle.moos
// NAME: Charles Benjamin
//-------------------------------------------------

// All processes in this community use the local MOOSDB. IP_ADDR is reserved
// for the externally advertised pShare address in pHostInfo below.
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB         @ NewConsole = false
  Run = pRealm         @ NewConsole = false
  Run = uProcessWatch  @ NewConsole = false
  Run = uLoadWatch     @ NewConsole = false
  Run = pShare         @ NewConsole = false
  Run = pHostInfo      @ NewConsole = false
  Run = pLogger        @ NewConsole = false
  Run = pNodeReporter  @ NewConsole = false
  Run = uFldNodeBroker @ NewConsole = false
  Run = pHelmIvP       @ NewConsole = false
#ifdef XMODE SIM
  Run = uSimMarineV22  @ NewConsole = false
  Run = pMarinePIDV22  @ NewConsole = false
#else
  Run = pArduBridge    @ NewConsole = false
  Run = pDeadManPost   @ NewConsole = false
  Run = uTimerScript   @ NewConsole = false ~ uRouteSequence
#endif
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

#ifdef XMODE SIM
  thresh = app=uSimMarineV22, gapthresh=3
  thresh = app=pMarinePIDV22, gapthresh=3
#else
  thresh = app=pArduBridge,   gapthresh=3
#endif
  thresh = app=pHelmIvP,      gapthresh=3
  thresh = app=pNodeReporter, gapthresh=4
  thresh = app=pHostInfo,     gapthresh=5
  thresh = app=any,           gapthresh=2.0

  breach_trigger = 5
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  // Pin the broker-advertised address to --ip. This prevents automatic
  // interface discovery from selecting Wi-Fi, Ethernet, or Tailscale.
  default_hostip_force = $(IP_ADDR=localhost)
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_$(VNAME)
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
}

//----------------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  platform_type   = quadcopter
  platform_color  = $(COLOR)
  platform_length = 4
  platform_group  = drone

  cross_fill_policy = global
  report_cog        = true
}

//----------------------------------------------------
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  auto_bridge_realmcast = false
  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

  bridge = src=NODE_REPORT_LOCAL, alias=NODE_REPORT
  bridge = src=NODE_MESSAGE_LOCAL, alias=NODE_MESSAGE
  bridge = src=VIEW_POINT
  bridge = src=VIEW_MARKER
  bridge = src=VIEW_VECTOR
  bridge = src=APPCAST

  bridge = src=UAV_COMMAND_RESULT
  bridge = src=UAV_IS_ARMED
  bridge = src=UAV_LANDED_STATE
  bridge = src=UAV_LANDING_TARGET_AVAILABLE
  bridge = src=UAV_LANDING_TARGET_AGE
  bridge = src=AUTOPILOT_MODE
  bridge = src=CONTROL_AUTHORITY
  bridge = src=IVPHELM_STATE
#ifdef XMODE SIM
  bridge = src=STATION_KEEP
#else
  bridge = src=DESIRED_HEADING
  bridge = src=DESIRED_SPEED
  bridge = src=DESIRED_ALTITUDE
#endif
#ifdef XMODE SITL
  bridge = src=NAV_ALTITUDE
#endif
#ifdef XMODE REAL
  bridge = src=NAV_ALTITUDE
#endif
}

//----------------------------------------------------
#ifdef XMODE SIM
ProcessConfig = uSimMarineV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  start_pos = -173, -128, 90
  prefix    = NAV

  max_speed        = 5
  max_deceleration = 2
  turn_rate        = 80
  turn_spd_loss    = 0.6

  post_des_thrust = DESIRED_THRUSTX
  post_des_rudder = DESIRED_RUDDERX
}

//----------------------------------------------------
ProcessConfig = pMarinePIDV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  verbose       = false
  depth_control = false
  active_start  = true

  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.1
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder   = 100
  maxthrust   = 100
  speed_factor = 20
}
#endif

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  ok_skew   = any
  behaviors = targ_$(VNAME).bhv
#ifdef XMODE SIM
#else
  // Route points may be staged before DEPLOY. DRIVE is safe here because all
  // horizontal behaviors remain idle until their explicit conditions are met.
  start_in_drive = true
#endif
  Domain    = course:0:359:360
  Domain    = speed:0:5:51
#ifdef XMODE SIM
#else
  Domain    = altitude:0:30:61
#endif
}

#ifdef XMODE SIM
#else
//----------------------------------------------------
// Order the Copter control handoff behind one route execution request. Route
// state remains mission-owned; pArduBridge receives only generic commands.
ProcessConfig = uRouteSequence
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  condition     = ROUTE_EXECUTE = true
  condition     = ROUTE_READY = true
  upon_awake    = restart
  script_atomic = true
  reset_max     = unlimited
  paused        = false
  script_name   = COPTER_ROUTE_SEQUENCE
  status_var    = ROUTE_SEQUENCE_STATUS

  event = var=HELM_STATUS,   val=true,         time=0
  event = var=ROUTE_DEPLOY,  val=true,         time=0.20
  event = var=ARDU_COMMAND,  val=FLY_WAYPOINT, time=0.80
  event = var=ROUTE_EXECUTE, val=false,        time=0.90
}

//----------------------------------------------------
ProcessConfig = pDeadManPost
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  // Arm only after the first viewer heartbeat. Twenty continuous seconds
  // without another heartbeat requests RTL through pArduBridge.
  heartbeat_var   = HEARTBEAT
  max_noheart     = 20
  post_policy     = reset
  active_at_start = false
  deadflag        = DEAD_MAN_POST_INTERRUPT = true
}

//----------------------------------------------------
ProcessConfig = pArduBridge
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  url          = $(AP_URL)
  url_protocol = $(AP_PROTOCOL)
  vehicle_type = copter

  vname  = $(VNAME)
  vcolor = $(COLOR)
  prefix = NAV

  takeoff_altitude              = $(TAKEOFF_ALTITUDE)
  command_groundspeed           = true
  is_sim                        = $(IS_SIM)
  logger                        = false
}
#endif
