//-------------------------------------------------
// FILE: meta_pearl.moos
// NAME: Charles Benjamin
//-------------------------------------------------

// All PEARL processes connect to the local MOOSDB. IP_ADDR is used only as
// the community's externally advertised pShare identity.
ServerHost = localhost
ServerPort = $(MOOS_PORT)
Community  = $(VNAME)

#include plug_origin_warp.moos

//----------------------------------------------------
ProcessConfig = ANTLER
{
  MSBetweenLaunches = 100

  Run = MOOSDB             @ NewConsole = false
  Run = pRealm             @ NewConsole = false
  Run = uProcessWatch      @ NewConsole = false
  Run = uLoadWatch         @ NewConsole = false
  Run = pShare             @ NewConsole = false
  Run = pHostInfo          @ NewConsole = false
  Run = pLogger            @ NewConsole = false
  Run = pEchoVar           @ NewConsole = false
  Run = pNodeReporter      @ NewConsole = false
  Run = uFldNodeBroker     @ NewConsole = false
  Run = uFldMessageHandler @ NewConsole = false
  Run = pHelmIvP           @ NewConsole = false

#ifdef XMODE REAL
  Run = iDualGPS           @ NewConsole = false
  Run = iPEARL             @ NewConsole = false
  Run = pPearlPID          @ NewConsole = false
  Run = iBlueRoboticsPing  @ NewConsole = false
#else
  Run = uSimMarineV22      @ NewConsole = false
  Run = pMarinePIDV22      @ NewConsole = false
#endif
}

//----------------------------------------------------
ProcessConfig = pShare
{
  AppTick   = 4
  CommsTick = 4

  input = route = localhost:$(PSHARE_PORT)
}

//----------------------------------------------------
ProcessConfig = pHostInfo
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  default_hostip_force = $(IP_ADDR=localhost)
}

//----------------------------------------------------
ProcessConfig = pRealm
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  relcast_interval = 0.8
  summary_interval = 2.0
}

//----------------------------------------------------
ProcessConfig = uProcessWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  allow_retractions = true
  watch_all         = true
  nowatch           = uMAC*
  nowatch           = uXMS*
  nowatch           = uPokeDB*
  nowatch           = uQueryDB*
  summary_wait      = 20
}

//----------------------------------------------------
ProcessConfig = uLoadWatch
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

#ifdef XMODE REAL
  thresh = app=iDualGPS,       gapthresh=3
  thresh = app=iPEARL,         gapthresh=3
  thresh = app=pPearlPID,      gapthresh=3
#else
  thresh = app=uSimMarineV22,  gapthresh=3
  thresh = app=pMarinePIDV22,  gapthresh=3
#endif
  thresh = app=pHelmIvP,       gapthresh=3
  thresh = app=pNodeReporter,  gapthresh=4
  thresh = app=pHostInfo,      gapthresh=5
  thresh = app=any,            gapthresh=2.0

  breach_trigger = 5
}

//----------------------------------------------------
ProcessConfig = pLogger
{
  AppTick       = 5
  CommsTick     = 5
  File          = LOG_$(VNAME)
  PATH          = ./
  AsyncLog      = true
  FileTimeStamp = true

  WildCardLogging     = true
  WildCardOmitPattern = *_STATUS
  WildCardOmitPattern = APPCAST
  WildCardOmitPattern = DB_VARSUMMARY
  WildCardOmitPattern = DB_RWSUMMARY
  WildCardOmitPattern = PHI_HOST*
  WildCardOmitPattern = NAV_PITCH
  WildCardOmitPattern = NAV_YAW
  WildCardOmitPattern = NAV_Z
}

//----------------------------------------------------
// Translate PEARL's sensors into the standard NAV variables and keep PEARL's
// operator controls namespaced away from the UAV.
ProcessConfig = pEchoVar
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  Echo = GPS_LATITUDE     -> NAV_LAT
  Echo = GPS_LONGITUDE    -> NAV_LONG
  Echo = GPS_X            -> NAV_X
  Echo = GPS_Y            -> NAV_Y
  Echo = GPS_HEADING_GPRMC -> NAV_HEADING
  Echo = IMU_PITCH        -> NAV_PITCH
  Echo = IMU_ROLL         -> NAV_ROLL
  Echo = GPS_SPEED        -> NAV_SPEED

  Echo = PEARL_DEPLOY          -> DEPLOY
  Echo = PEARL_RETURN          -> RETURN
  Echo = PEARL_STATION_KEEP    -> STATION_KEEP
  Echo = PEARL_MANUAL_OVERRIDE -> MOOS_MANUAL_OVERRIDE
}

//----------------------------------------------------
ProcessConfig = pNodeReporter
{
  AppTick   = 2
  CommsTick = 2
  term_report_interval = 2

  platform_type   = ship
  platform_color  = $(COLOR)
  platform_length = 2.8
  platform_group  = surface

  cross_fill_policy = global
  report_cog        = true
}

//----------------------------------------------------
ProcessConfig = uFldNodeBroker
{
  AppTick   = 1
  CommsTick = 1
  term_report_interval = 2

  auto_bridge_realmcast = false
  try_shore_host = pshare_route=$(SHORE_IP):$(SHORE_PSHARE)

  bridge = src=NODE_REPORT_LOCAL, alias=NODE_REPORT
  bridge = src=VIEW_POLYGON
  bridge = src=VIEW_POINT
  bridge = src=VIEW_SEGLIST
  bridge = src=VIEW_CIRCLE
  bridge = src=APPCAST
  bridge = src=IVPHELM_STATE
  bridge = src=PROC_WATCH_ALL_OK, alias=PEARL_PROC_WATCH_ALL_OK
}

//----------------------------------------------------
ProcessConfig = uFldMessageHandler
{
  AppTick   = 3
  CommsTick = 3
  term_report_interval = 2

  strict_addressing = true
}

//----------------------------------------------------
ProcessConfig = pHelmIvP
{
  AppTick   = 4
  CommsTick = 4
  term_report_interval = 2

  ok_skew   = any
  behaviors = targ_$(VNAME).bhv
  Domain    = course:0:359:360
  Domain    = speed:0:0.5:11
}

#ifdef XMODE REAL
//----------------------------------------------------
// PEARL hardware configuration retained from may_test_run.
ProcessConfig = iDualGPS
{
  AppTick   = 10
  CommsTick = 10

  DUAL_GPS = false
  PORT_1   = /dev/ttyAMA5   // Port GPS
  BAUDRATE = 9600
  PREFIX   = GPS

  HEADING_OFFSET = 0.0
  PUBLISH_RAW     = true
  PUBLISH_HDOP    = true
  TRIGGER_MSG     = GNGGA
}

//----------------------------------------------------
ProcessConfig = iPEARL
{
  AppTick   = 10
  CommsTick = 10

  PORT           = /dev/ttyACM0
  BAUDRATE       = 115200
  PREFIX         = IMU
  HEADING_OFFSET = 0.0

  LEFT_MOTOR_FRAC  = 1.0
  RIGHT_MOTOR_FRAC = 1.0
}

//----------------------------------------------------
ProcessConfig = pPearlPID
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  VERBOSE       = true
  DEPTH_CONTROL = false
  ACTIVE_START  = true

  SUN_TRACKING                = false
  HEADING_DEADBAND            = 5
  HOLONOMIC_TURN              = true
  HOLONOMIC_TURN_ON_ERROR     = 30
  HOLONOMIC_TURN_OFF_ERROR    = 10
  HOLONOMIC_TURN_MAX_SPEED = 0.06 // m/s; only pivot-turn when nearly stopped
  YAW_PID_KP                  = 0.25
  YAW_PID_KI                  = 0.00
  YAW_PID_KD                  = 2
  YAW_PID_INTEGRAL_LIMIT      = 0.00
  SPEED_PID_KP                = 1.0
  SPEED_PID_KD                = 0.0
  SPEED_PID_KI                = 0.0
  SPEED_PID_INTEGRAL_LIMIT    = 0.07
  SPEED_FACTOR                = 0
}

//----------------------------------------------------
ProcessConfig = iBlueRoboticsPing
{
  AppTick   = 4
  CommsTick = 4
}
#else
//----------------------------------------------------
ProcessConfig = uSimMarineV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  start_pos = $(START_POS)
  prefix    = NAV

  max_speed        = 1
  max_deceleration = 0.5
  turn_rate        = 100
  turn_spd_loss    = 0.6

  post_des_thrust = DESIRED_THRUSTX
  post_des_rudder = DESIRED_RUDDERX
}

//----------------------------------------------------
ProcessConfig = pMarinePIDV22
{
  AppTick   = 10
  CommsTick = 10
  term_report_interval = 2

  verbose       = false
  depth_control = false
  active_start  = true

  yaw_pid_kp             = 1.2
  yaw_pid_kd             = 0.1
  yaw_pid_ki             = 0.3
  yaw_pid_integral_limit = 0.07

  speed_pid_kp             = 1.0
  speed_pid_kd             = 0.0
  speed_pid_ki             = 0.0
  speed_pid_integral_limit = 0.07

  maxrudder   = 100
  maxthrust   = 100
  speed_factor = 20
}
#endif
